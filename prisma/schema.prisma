generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  PAINTING
  SCULPTURE
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  passwordHash      String
  resetTokenHash    String?
  resetTokenExpires DateTime?
  invitationsSent   Invitation[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

/**
 * Invitation link to create an atelier account (no public sign-up).
 */
model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Artwork {
  id            String         @id @default(cuid())
  title         String
  titleEn       String         @default("")
  slug          String         @unique
  category      Category
  medium        String
  year          Int
  dimensions    String?
  imageUrl      String
  description   String?
  descriptionEn String         @default("")
  colSpan       Int            @default(4)
  aspectRatio   String         @default("1/1")
  stretch       Boolean        @default(false)
  published     Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        ArtworkPhoto[]

  @@index([published, sortOrder])
}

/**
 * Extra photos shown on the artwork's "Discover" page (details, other angles).
 */
model ArtworkPhoto {
  id        String   @id @default(cuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([artworkId, sortOrder])
}

/**
 * Singleton: hero, bio, portrait, contact — edited in /studio
 */
model SiteContent {
  id             String @id @default("main")
  heroImageUrl   String
  heroImageAltFr String @default("")
  heroImageAltEn String @default("")
  portraitUrl    String

  bioLeadFr String
  bioLeadEn String
  bioBornFr String
  bioBornEn String
  bioP1Fr   String
  bioP1En   String
  bioP2Fr   String
  bioP2En   String
  bioP3Fr   String
  bioP3En   String

  email        String
  instagramUrl String
  facebookUrl  String

  updatedAt DateTime @updatedAt
}

model InSituWork {
  id          String   @id @default(cuid())
  title       String
  titleEn     String   @default("")
  place       String   @default("")
  placeEn     String   @default("")
  year        Int?
  imageUrl    String
  description String   @default("")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  titleEn   String   @default("")
  source    String   @default("")
  sourceEn  String   @default("")
  year      Int?
  url       String   @default("")
  imageUrl  String   @default("")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/**
 * People who left their e-mail in the site menu (newsletter).
 */
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
